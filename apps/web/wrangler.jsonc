{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "poll-request",
	"main": "src/server.ts",
	// 2026-02-24 or later makes storage.deleteAll() also delete the alarm.
	"compatibility_date": "2026-10-19",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		// Invocation logs record request headers, and Authorization carries the admin token. console output stays on.
		"logs": {
			"invocation_logs": false
		}
	},
	"upload_source_maps": true,
	// wrangler refuses to deploy until the secret exists. Locally it comes from .dev.vars (scripts/ensure-dev-vars.mjs).
	"secrets": {
		"required": ["VOTER_SECRET"]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "POLL_ROOM",
				"class_name": "PollRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["PollRoom"]
		}
	],
	"d1_databases": [
		{
			"binding": "KPI_DB",
			"database_name": "poll-request-kpi",
			"database_id": "2402ad91-f02f-4cd9-ac2b-7d9603f44454",
			"migrations_dir": "migrations"
		}
	],
	"ratelimits": [
		{
			"name": "CREATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		{
			"name": "VOTE_LIMITER",
			"namespace_id": "1002",
			"simple": {
				"limit": 20,
				"period": 10
			}
		},
		{
			"name": "ADMIN_LIMITER",
			"namespace_id": "1003",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	],
	"env": {
		// Bindings and secrets are not inherited, so each one is repeated here (migrations are inherited).
		// A separate database and rate limit namespace keep PR previews out of production KPIs and counters.
		"preview": {
			"secrets": {
				"required": ["VOTER_SECRET"]
			},
			"durable_objects": {
				"bindings": [
					{
						"name": "POLL_ROOM",
						"class_name": "PollRoom"
					}
				]
			},
			"d1_databases": [
				{
					"binding": "KPI_DB",
					"database_name": "poll-request-kpi-preview",
					"database_id": "a04ee95a-f045-4704-a9a1-0659421139a9",
					"migrations_dir": "migrations"
				}
			],
			"ratelimits": [
				{
					"name": "CREATE_LIMITER",
					"namespace_id": "2001",
					"simple": {
						"limit": 5,
						"period": 60
					}
				},
				{
					"name": "VOTE_LIMITER",
					"namespace_id": "2002",
					"simple": {
						"limit": 20,
						"period": 10
					}
				},
				{
					"name": "ADMIN_LIMITER",
					"namespace_id": "2003",
					"simple": {
						"limit": 10,
						"period": 60
					}
				}
			]
		}
	}
}
